# ============================================================
# SitePyoe POS — Production Cloud Environment Configuration
# ============================================================

# Backend Port (Default: 5001 or provided by cloud host like Render/Railway/Fly.io)
PORT=5001
NODE_ENV=production

# Cloud Managed PostgreSQL Database URL (e.g. Supabase, Neon, Railway, AWS RDS, DigitalOcean)
# Example: postgresql://user:password@ep-sample-123.ap-southeast-1.aws.neon.tech/sitepyoe?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/sitepyoe

# JWT Authentication Secrets (Generate strong random 64-char strings)
JWT_SECRET=sitepyoe_jwt_production_secret_key_change_to_secure_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=sitepyoe_jwt_production_refresh_secret_change_to_secure_random
JWT_REFRESH_EXPIRES_IN=30d

